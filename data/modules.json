{
  "graphics": {
    "modules": [
      {
        "name": "lod",
        "display": "Model Quality",
        "description": "Controls how detailed models are.",
        "cpu": 1,
        "gpu": 2,
        "values": [
          {
            "value": "low",
            "description": "Low model detail"
          },
          {
            "value": "medium",
            "description": "Medium model detail"
          },
          {
            "value": "high",
            "description": "High model detail"
          },
          {
            "value": "ultra",
            "description": "Forces high model detail regardless of distance"
          }
        ]
      },
      {
        "name": "lighting",
        "description": "Controls lighting fidelity",
        "cpu": 2,
        "gpu": 3,
        "values": [
          {
            "value": "very_low",
            "description": "No dynamic lightmaps and skips all movable lighting. No lightwarps or rimlights."
          },
          {
            "value": "low",
            "description": "No dynamic lightmaps and only applies ambient movable lighting. No lightwarps or rimlights."
          },
          {
            "value": "medium",
            "description": "No dynamic lightmaps and applies detailed movable lighting"
          },
          {
            "value": "high",
            "description": "1 dynamic lightmap and applies detailed movable lighting."
          },
          {
            "value": "ultra",
            "description": "Maximum dynamic lightmaps and applies extremely detailed movable lighting."
          }
        ]
      },
      {
        "name": "shading",
        "display": "Shading",
        "description": "Controls advanced shading commands which cause a material system reload.",
        "cpu": 1,
        "gpu": 3,
        "values": [
          {
            "value": "low",
            "description": "Disables bumpmaps and specular, and uses low quality shader fallbacks in some cases."
          },
          {
            "value": "medium",
            "description": "Disables bumpmaps and specular, and uses low quality shader fallbacks in some cases."
          },
          {
            "value": "high",
            "description": "Enables bumpmaps and specular."
          }
        ]
      },
      {
        "name": "phong",
        "display": "Phong Shading",
        "description": "Controls phong highlights for shading.",
        "cpu": 1,
        "gpu": 3,
        "values": [
          {
            "value": "off",
            "description": "Uses diffuse shading."
          },
          {
            "value": "on",
            "description": "Uses phong shading."
          },
          {
            "value": "rim",
            "display": "On + Rimlighting",
            "description": "Uses phong shading, with rimlighting."
          }
        ]
      },
      {
        "name": "shadows",
        "description": "Controls shadow quality. Shadow limits affect rendered shadows. Shadows above the limit will be blobby.",
        "cpu": 3,
        "gpu": 2,
        "values": [
          {
            "value": "off",
            "description": "No dynamic shadows"
          },
          {
            "value": "low",
            "description": "Blobby shadows"
          },
          {
            "value": "medium",
            "description": "Up to 3 low quality shadows"
          },
          {
            "value": "high",
            "description": "Up to 23 high quality shadows and limited NPC shadow distance"
          },
          {
            "value": "ultra",
            "description": "Up to 160 ultra quality movable shadows and unlimited NPC shadow distance"
          }
        ]
      },
      {
        "name": "flashlight",
        "type": "switch",
        "description": "Controls flashlight support. Flashlights are not used in TF2, so you should keep it disabled unless you need it for a certain community server mod, like Slender, or some Deathrun servers.",
        "notes": [
          {
            "level": "warning",
            "content": "Turning on flashlight support will cause rendering artifacts on some maps, especially when Pyroland is enabled"
          }
        ],
        "cpu": 1,
        "gpu": 2,
        "values": [
          {
            "value": "off",
            "description": "Disables flashlight support."
          },
          {
            "value": "on",
            "description": "Enables flashlight support. If the `shadows` module is `off`, this will set it to the `low` level."
          }
        ]
